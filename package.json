{
  "name": "n8n-nodes-ipgeolocation",
  "version": "2.0.0",
  "description": "Integrate ipgeolocation.io with n8n to automate IP lookup, geolocation, timezone data, and security checks for powerful workflow enrichment.",
  "license": "MIT",
  "homepage": "",
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes-ipgeolocation",
    "ipgeolocation",
    "ipgeolocation.io"
  ],
  "author": {
    "name": "IPGeolocation",
    "email": "support@ipgeolocation.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IPGeolocation/n8n-nodes-ipgeolocation.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/IpgeolocationApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ipgeolocation/Ipgeolocation.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@opentelemetry/instrumentation": "^0.212.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "handlebars": "4.7.9",
    "n8n-workflow": {
      "form-data": "4.0.6",
      "lodash": "4.18.1"
    },
    "release-it": {
      "undici": "^6.28.0"
    },
    "eslint-plugin-n8n-nodes-base": {
      "@typescript-eslint/typescript-estree": {
        "minimatch": "^9.0.7"
      }
    },
    "@langchain/community": "1.1.18",
    "langsmith": "^0.10.5",
    "uuid": "^11.1.1",
    "@langchain/core": "1.2.13"
  }
}
